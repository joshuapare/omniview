  },
  "KafkaRebalance": {
    "fields": [
      {
        "label": "Kafka cluster",
        "path": "metadata.labels[strimzi.io/cluster]",
        "type": "text",
        "options": ""
      },
      {
        "label": "Mode",
        "path": "spec.mode",
        "type": "select",
        "options": "full|add-brokers|remove-brokers"
      },
      {
        "label": "Broker IDs",
        "path": "spec.brokers",
        "type": "text",
        "options": ""
      },
      {
        "label": "Throttle · bytes/s",
        "path": "spec.replicationThrottle",
        "type": "number",
        "options": ""
      }
    ],
    "extras": [],
    "repeatable": "Ordered Goals",
    "columns": [
      "Goal"
    ],
    "paths": [
      "spec.goals[]"
    ],
    "consequence": "Default entry is inspect/action. Only explicitly user-managed requests allow authoring. Approval moves partition replicas."
  }
}